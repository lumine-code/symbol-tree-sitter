{
  "name": "symbol-tree-sitter",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides symbols via Tree-sitter tags queries.",
  "keywords": [
    "navigation",
    "declaration",
    "tags-query",
    "outline",
    "grammar",
    "scm"
  ],
  "repository": "https://github.com/lumine-code/symbol-tree-sitter",
  "bugs": {
    "url": "https://github.com/lumine-code/symbol-tree-sitter/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "types": "./lib/main.d.ts",
  "files": [
    "lib",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-javascript",
    "language-ruby"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "includeReferences": {
      "title": "Include References",
      "description": "Whether to make symbols out of references (for example, function calls) in addition to definitions.",
      "type": "boolean",
      "default": false
    }
  },
  "providedServices": {
    "symbol.document-provider": {
      "description": "Supplies symbols from the current document's Tree-sitter queries.",
      "versions": {
        "1.1.0": "provideDocumentSymbolProvider"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#29d4f94c9f8be8b46236c37971200a30f1c72a4a",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#8360f4f0dd48d0dd05fd7f90e2a488d9bb9779a6",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-n": "^18.6.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.16.0": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.9"
    }
  }
}
