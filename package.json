{
  "name": "symbol-tree-sitter",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides symbols via Tree-sitter tags queries.",
  "keywords": [
    "navigation",
    "declaration",
    "tags-query",
    "outline",
    "grammar",
    "scm"
  ],
  "repository": "https://github.com/lumine-code/symbol-tree-sitter",
  "bugs": {
    "url": "https://github.com/lumine-code/symbol-tree-sitter/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "types": "./lib/main.d.ts",
  "files": [
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-javascript",
    "language-ruby"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "includeReferences": {
      "title": "Include References",
      "description": "Whether to make symbols out of references (for example, function calls) in addition to definitions.",
      "type": "boolean",
      "default": false
    }
  },
  "providedServices": {
    "symbol.document-provider": {
      "description": "Supplies symbols from the current document's Tree-sitter queries.",
      "versions": {
        "1.0.0": "provideDocumentSymbolProvider"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#016145716ab8ec3cb331053f447fda95eb0fb66a",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#2b4bd6242c342e98f4302a546cfc87b158c2c177",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
